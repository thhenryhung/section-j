{
  "name": "section-j",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A section website for HBS MBA 2028 Section J — directory, meetup allocator, face quiz, and calendar.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "npm run data:sample && npm run data:encrypt",
    "dev": "vite",
    "prebuild": "npm run data:sample && npm run data:encrypt",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "data:parse": "tsx scripts/parse-classcards.ts",
    "data:photos": "tsx scripts/build-photos.ts",
    "data:encrypt": "tsx scripts/encrypt-data.ts",
    "data:sample": "tsx scripts/make-sample.ts",
    "data:all": "npm run data:parse && npm run data:photos && npm run data:encrypt",
    "pair": "tsx scripts/pair.ts",
    "check:leaks": "tsx scripts/check-leaks.ts"
  },
  "dependencies": {
    "fuse.js": "^7.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "cheerio": "^1.1.2",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.4"
  }
}
